# Dohuub Mobile
#
# API_URL must include the /api/v1 suffix.
# Production (Railway): https://dohuub-progressive-web-app-backend-production.up.railway.app/api/v1
#
# For local backend development instead:
# - iOS Simulator: http://localhost:4000/api/v1
# - Android Emulator: http://10.0.2.2:4000/api/v1
# - Physical device: http://<your-machine-LAN-IP>:4000/api/v1
API_URL=https://dohuub-progressive-web-app-backend-production.up.railway.app/api/v1

# API request/response console logging. Empty = on in dev, off in release.
API_LOGS=true

# Stripe publishable key (test mode). Safe to expose client-side.
STRIPE_PUBLISHABLE_KEY=

# Custom URL scheme registered in Info.plist / AndroidManifest.xml,
# used for Stripe 3-D-Secure / off-site payment return redirects.
STRIPE_RETURN_URL=dohuub://checkout/return

# Same custom URL scheme, used as the redirect target for the Google
# sign-in browser flow (backend mints the Google authorize URL via
# Supabase — no separate mobile OAuth client is needed).
GOOGLE_AUTH_REDIRECT_URL=dohuub://auth/google

# Google Maps (Android / iOS SDK + reverse geocode for country codes)
GOOGLE_MAPS_API_KEY=

